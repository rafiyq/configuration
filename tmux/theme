set -g pane-border-style "fg=brightblack"
set -g pane-active-border-style "fg=pink"
set -g message-style "bg=default,fg=pink"
set -g message-command-style "bg=default,fg=pink"
set -g mode-style "bg=pink,fg=black"
setw -g clock-mode-colour pink

# Left Side
set -g status-left ""
set -g window-status-format "#[bg=brightblack] #W (#I)"
set -g window-status-current-format "#[fg=black,bg=pink,bold] #W "

# Right Side
set -g status-right "\
#[fg=pink]#{?pane_in_mode,COPY ,}\
#{?client_prefix,PREFIX ,}
#{?window_zoomed_flag,ZOOM ,}\
#[fg=brightblack] #h \
#[fg=black,bg=pink,bold] #S \
"
